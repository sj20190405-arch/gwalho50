// 한글을 자모로 풀어서 받침·모음 하나 틀린 정도의 맞춤법 오류를 허용
function jamo(s){ let o=""; for(const ch of s){ const c=ch.charCodeAt(0)-0xAC00;
  if(c>=0 && c<11172){ o+=String.fromCharCode(0x1100+Math.floor(c/588), 0x1161+Math.floor((c%588)/28)); const t=c%28; if(t) o+=String.fromCharCode(0x11A7+t); } else o+=ch; } return o; }
function norm(s){
  return String(s||"").replace(/Ⅲ/g,"3").replace(/Ⅱ/g,"2").replace(/Ⅰ/g,"1").toLowerCase()
    .replace(/\(iii\)/g,"3").replace(/\(ii\)/g,"2")
    .replace(/[₀-₉]/g,c=>String(c.charCodeAt(0)-0x2080))
    .replace(/[⁰¹²³⁴-⁹]/g,c=>({"⁰":"0","¹":"1","²":"2","³":"3","⁴":"4","⁵":"5","⁶":"6","⁷":"7","⁸":"8","⁹":"9"})[c]||"")
    .replace(/[⁺⁻+\-−]/g,"")
    .replace(/[\s()（）\[\]{}.,·ㆍ•:;'"`~!?%]/g,"");
}
function variants(q){
  const ans = q.a;
  const v = new Set([ans, ...(q.alt||[])]);
  const m = ans.match(/^(.*)\(([^()]+)\)$/);            // 예: 국제 연합 개발 계획(UNDP)
  if (m){ v.add(m[1]); v.add(m[2]);
    const m2 = m[1].match(/^(.*)\(([^()]+)\)$/); if (m2){ v.add(m2[1]); } }
  (ALTS[ans]||[]).forEach(x=>v.add(x));
  return [...v].map(norm).filter(Boolean);
}
const VARS = Q.map(q=>variants(q));
