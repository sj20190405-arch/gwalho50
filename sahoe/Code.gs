 "공동선":["공공선"], "개인선":["개인의 선","사적 선"], "밀":["존 스튜어트 밀","js밀"],
};
Object.entries(SYN).forEach(([k,v])=>{ ALTS[k] = (ALTS[k]||[]).concat(v); });
// 뒤에 붙는 일반 명사(원칙·원리·제도 등)와 조사는 떼고 비교
const SUFFIXES = ["원칙","원리","제도","심판","운동","현상","활동"];
