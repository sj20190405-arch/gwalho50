// 뒤에 붙는 일반 명사(반응·현상 등)와 조사는 떼고 비교
const SUFFIXES = ["반응","현상","생물군","처리","작용"];
const PARTICLES = ["으로","에서","이다","입니다","은","는","이","가","을","를","의","로","와","과","에","도","다"];
// 한글을 자모로 풀어서 받침·모음 하나 틀린 정도의 맞춤법 오류를 허용
function jamo(s){ let o=""; for(const ch of s){ const c=ch.charCodeAt(0)-0xAC00;
  if(c>=0 && c<11172){ o+=String.fromCharCode(0x1100+Math.floor(c/588), 0x1161+Math.floor((c%588)/28)); const t=c%28; if(t) o+=String.fromCharCode(0x11A7+t); } else o+=ch; } return o; }
function norm(s){
  return String(s||"").replace(/Ⅲ/g,"3").replace(/Ⅱ/g,"2").replace(/Ⅰ/g,"1").toLowerCase()
    .replace(/\(iii\)/g,"3").replace(/\(ii\)/g,"2")
    .replace(/[₀-₉]/g,c=>String(c.charCodeAt(0)-0x2080))
    .replace(/[⁰¹²³⁴-⁹]/g,c=>({"⁰":"0","¹":"1","²":"2","³":"3","⁴":"4","⁵":"5","⁶":"6","⁷":"7","⁸":"8","⁹":"9"})[c]||"")
    .replace(/[⁺⁻+\-−]/g,"")
    .replace(/[\s()（）\[\]{}.,·ㆍ•:;'"`~!?%]/g,"");
}
function variants(q){
  const ans = q.a;
  const v = new Set([ans, ...(q.alt||[])]);
  const m = ans.match(/^(.*)\(([^()]+)\)$/);            // 구리 이온(Cu²⁺) / 산화 철(Ⅲ)(Fe₂O₃)
  if (m){ v.add(m[1]); v.add(m[2]);
    const m2 = m[1].match(/^(.*)\(([^()]+)\)$/); if (m2){ v.add(m2[1]); } }
  (ALTS[ans]||[]).forEach(x=>v.add(x));
  return [...v].map(norm).filter(Boolean);
}
const VARS = Q.map(q=>variants(q));
// words that are one typo away from a real answer but mean something else
const TRAPS = new Set([...Q.map(q=>norm(q.a)), ...["고생대","중생대","신생대","겉씨식물","속씨식물","양치식물","산화","환원","흡수","방출","액화","기화","응고","융해","산성","중성","염기성","증가","감소","산소","수소","질소","탄소"].map(norm)]);
function lev(a,b){
  const m=a.length,n=b.length; if(!m) return n; if(!n) return m;
  let p=Array.from({length:n+1},(_,j)=>j);
  for(let i=1;i<=m;i++){ const c=[i];
    for(let j=1;j<=n;j++) c[j]=Math.min(p[j]+1,c[j-1]+1,p[j-1]+(a[i-1]===b[j-1]?0:1));
    p=c; }
  return p[n];
}
function matchOne(x, v){
  if (x===v) return true;
  if (TRAPS.has(x)) return false;                       // 다른 정답 용어(중생대↔신생대 등)는 오답
  if (/^[0-9a-z]+$/.test(v)) return false;              // 숫자·화학식은 정확히
  // 1) 글자 단위 오탈자: 4~6글자 1자, 7자 이상 2자
  const tol = v.length<=3 ? 0 : v.length<=6 ? 1 : 2;
  if (tol>0 && (v.length>=7 || x.length>=v.length) && lev(x,v)<=tol) return true;   // 짧은 말은 글자 빠짐 불허(종다양성↔다양성)
  // 2) 자모 단위 맞춤법 오류(받침·모음 실수): 2~3글자 1개, 4글자 이상 2개
  if (/[가-힣]/.test(v) && v.length>=2){
    const jx=jamo(x), jv=jamo(v), jt = v.length<=3 ? 1 : 2;
    if (Math.abs(jx.length-jv.length)<=jt && lev(jx,jv)<=jt){
      // 같은 위치 글자의 초성이 바뀐 경우(산화↔산하 정도는 허용, 2글자어의 첫 글자 교체는 불허)
      if (!(v.length<=2 && x[0]!==v[0])) return true;
    }
  }
  return false;
}
function forms(x){
  const out=new Set([x]);
  for(const p of PARTICLES) if (x.length>p.length+1 && x.endsWith(p)) out.add(x.slice(0,-p.length));
  for(const f of [...out]) for(const sfx of SUFFIXES) if (f.length>sfx.length+1 && f.endsWith(sfx)) out.add(f.slice(0,-sfx.length));
  return [...out];
}
function isCorrect(i, raw){
  const x0 = norm(raw); if (!x0) return false;
  const vs = new Set(VARS[i]);
  VARS[i].forEach(v=>{ for(const sfx of SUFFIXES) if (v.length>sfx.length+1 && v.endsWith(sfx)) vs.add(v.slice(0,-sfx.length)); });
  return forms(x0).some(x=>[...vs].some(v=>matchOne(x,v)));
}
// sub = {qs:[original indices], answers:[aligned], overrides:{origIdx:true}}; old docs without qs = all 100
function gradeSub(sub){
  const qs = Array.isArray(sub.qs) ? sub.qs : Q.map((_,i)=>i);
  const ov = sub.overrides||{}, ans = sub.answers||[];
  const items = qs.map((qi,p)=>({qi, p, ans: ans[p]||"", ok: ov[qi]===true || isCorrect(qi, ans[p])}));
  return {items, score: items.filter(x=>x.ok).length, total: qs.length};
}


// ---------- scope & daily random set ----------
const K = 50;
const SCOPES = {
  u1:  {label:"1단원", full:"1. 지질 시대와 생물다양성", secs:[0,1,2,3]},
  u2:  {label:"2단원", full:"2. 화학 변화와 에너지 출입", secs:[4,5,6,7]},
  all: {label:"전체",  full:"1·2단원 전체", secs:[0,1,2,3,4,5,6,7]},
};
function hash(str){ let h=2166136261; for(const c of str){ h^=c.codePointAt(0); h=Math.imul(h,16777619); } return h>>>0; }
function rng(seed){ let a=seed||1; return ()=>{ a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
function shuffle(arr, r){ for(let i=arr.length-1;i>0;i--){ const j=Math.floor(r()*(i+1)); [arr[i],arr[j]]=[arr[j],arr[i]]; } return arr; }
function pickSet(scope, seedStr){
  const r = rng(hash(seedStr)), secs = SCOPES[scope].secs;
  const sizes = secs.map(si=>SECTIONS[si].q.length), total = sizes.reduce((a,b)=>a+b,0);
  const want = sizes.map(n=>n*K/total), take = want.map(Math.floor);
  let left = K - take.reduce((a,b)=>a+b,0);
  for(const i of shuffle(sizes.map((_,i)=>i), r)){ if(left<=0) break; if(want[i]>take[i]){ take[i]++; left--; } }
  const out=[];
  secs.forEach((si,k)=>{ const pool=Q.map((q,i)=>q.si===si?i:-1).filter(i=>i>=0); out.push(...shuffle(pool,r).slice(0,take[k])); });
  return out;
}
// Korean date (UTC+9) — the test changes every day at midnight KST
function today(){ return new Date(Date.now()+9*3600e3).toISOString().slice(0,10); }
function fmtDate(d){ const [y,m,dd]=d.split("-"); return `${+m}월 ${+dd}일`; }

// =====================================================================
//  API (GitHub Pages 의 index.html 이 이 주소로 요청을 보냅니다)
// =====================================================================
const DEFAULT_PW = "0405";              // 스크립트 속성 TEACHER_PW 가 있으면 그 값을 사용
const SHEET = "결과";
const HEAD = ["날짜","범위","반","번호","이름","점수","만점","제출시각","응시횟수","틀린 문항(문제은행 번호)","key","qs","answers","overrides"];
const TZ = "Asia/Seoul";

function doGet() { return json_({ ok: true, message: "괄호넣기 API 가 동작 중입니다.", today: todayKST_() }); }
function doPost(e) {
  let req = {};
  try { req = JSON.parse((e && e.postData && e.postData.contents) || "{}"); } catch (err) { return json_({ ok: false, error: "잘못된 요청입니다." }); }
  const fn = ROUTES[req.action];
  if (!fn) return json_({ ok: false, error: "알 수 없는 요청입니다." });
  try { return json_({ ok: true, data: fn(req) }); }
  catch (err) { return json_({ ok: false, error: String((err && err.message) || err) }); }
}
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function todayKST_() { return Utilities.formatDate(new Date(), TZ, "yyyy-MM-dd"); }

// ---------- storage ----------
function sheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET);
  if (!sh) {
    sh = ss.insertSheet(SHEET);
    sh.getRange(1, 1, 1, HEAD.length).setValues([HEAD]).setFontWeight("bold").setBackground("#dce6f2");
    sh.setFrozenRows(1);
    sh.hideColumns(11, 4);
  }
  return sh;
}
function rows_() {
  const sh = sheet_(), n = sh.getLastRow() - 1;
  if (n < 1) return [];
  return sh.getRange(2, 1, n, HEAD.length).getDisplayValues().map((r, i) => ({
    row: i + 2, date: r[0], scope: r[1], cls: +r[2], num: +r[3], name: r[4], submittedAt: r[7], attempts: +r[8] || 1,
    key: r[10], qs: JSON.parse(r[11] || "[]"), answers: JSON.parse(r[12] || "[]"), overrides: JSON.parse(r[13] || "{}")
  }));
}
function scopeLabel_(k) { return (SCOPES[k] || {}).label || k; }
function scopeKey_(label) { for (const k in SCOPES) if (SCOPES[k].label === label || k === label) return k; return label; }
function writeRow_(rec) {
  const g = gradeSub(rec);
  const vals = [rec.date, scopeLabel_(rec.scope), rec.cls, rec.num, rec.name, g.score, g.total, rec.submittedAt, rec.attempts,
    g.items.filter(x => !x.ok).map(x => x.qi + 1).join(" "), rec.key, JSON.stringify(rec.qs), JSON.stringify(rec.answers), JSON.stringify(rec.overrides || {})];
  const sh = sheet_();
  const row = rec.row || sh.getLastRow() + 1;
  sh.getRange(row, 1, 1, HEAD.length).setNumberFormat("@").setValues([vals.map(String)]);
}
function load_() { return rows_().map(r => ({ ...r, scope: scopeKey_(r.scope) })); }
function settings_() {
  const p = PropertiesService.getScriptProperties();
  return { showAnswers: p.getProperty("showAnswers") !== "false", allowRetry: p.getProperty("allowRetry") === "true", fixedScope: p.getProperty("fixedScope") || "" };
}
function checkPw_(pw) {
  const real = PropertiesService.getScriptProperties().getProperty("TEACHER_PW") || DEFAULT_PW;
  if (String(pw || "").trim() !== real) throw new Error("비밀번호가 맞지 않습니다.");
}
function ident_(id) {
  const cls = parseInt(id && id.cls, 10), num = parseInt(id && id.num, 10), name = String((id && id.name) || "").trim().slice(0, 20);
  if (!(cls >= 1 && cls <= 20) || !(num >= 1 && num <= 40) || name.length < 2) throw new Error("반, 번호, 이름을 정확히 입력하세요.");
  return { cls, num, name, who: cls + "-" + num };
}
function withLock_(f) { const l = LockService.getScriptLock(); l.waitLock(20000); try { return f(); } finally { l.releaseLock(); } }
function result_(rec) {
  const g = gradeSub(rec), s = settings_();
  return {
    date: rec.date, scope: rec.scope, cls: rec.cls, num: rec.num, name: rec.name, score: g.score, total: g.total,
    submittedAt: rec.submittedAt, attempts: rec.attempts, showAnswers: s.showAnswers, allowRetry: s.allowRetry,
    items: g.items.map(x => ({ p: x.p, si: Q[x.qi].si, b: Q[x.qi].b, c: Q[x.qi].c, ans: x.ans, ok: x.ok, correct: s.showAnswers ? Q[x.qi].a : null }))
  };
}

// ---------- routes ----------
const ROUTES = {
  /** 첫 화면 정보 */
  config(req) {
    const s = settings_(), d = todayKST_();
    const sizes = {}; for (const k in SCOPES) sizes[k] = SCOPES[k].secs.reduce((t, i) => t + SECTIONS[i].q.length, 0);
    let mine = {};
    if (req.ident) { try { const me = ident_(req.ident); load_().filter(r => r.date === d && r.key.endsWith("|" + me.who)).forEach(r => { const g = gradeSub(r); mine[r.scope] = { score: g.score, total: g.total }; }); } catch (e) {} }
    return { today: d, sections: SECTIONS.map(x => x.t), scopes: SCOPES, sizes, total: N, settings: { fixedScope: s.fixedScope, allowRetry: s.allowRetry, showAnswers: s.showAnswers }, mine };
  },
  /** 시험 시작: 이미 봤으면 결과, 아니면 오늘 문제(정답 제외) */
  start(req) {
    const me = ident_(req.ident), s = settings_(), d = todayKST_();
    const scope = SCOPES[req.scope] ? req.scope : null; if (!scope) throw new Error("시험 범위를 고르세요.");
    if (s.fixedScope && s.fixedScope !== scope) throw new Error("오늘은 " + scopeLabel_(s.fixedScope) + " 범위만 응시할 수 있습니다.");
    const key = d + "|" + scope + "|" + me.who;
    const rec = load_().find(r => r.key === key);
    if (rec && !(req.retry && s.allowRetry)) return { mode: "result", result: result_(rec) };
    const attempt = rec ? rec.attempts : 0;
    const qs = pickSet(scope, d + "|" + scope + "|" + me.who + "-" + me.name + "|" + attempt);
    return { mode: "quiz", date: d, scope, attempt, allowRetry: s.allowRetry, questions: qs.map(qi => ({ si: Q[qi].si, b: Q[qi].b, c: Q[qi].c })) };
  },
  /** 제출: 서버가 문제 세트를 다시 계산해 채점·저장 */
  submit(req) {
    const me = ident_(req.ident), s = settings_();
    const scope = req.scope, d = String(req.date || "");
    if (!SCOPES[scope]) throw new Error("시험 범위가 올바르지 않습니다.");
    if (d !== todayKST_()) throw new Error("날짜가 바뀌었습니다. 처음 화면으로 돌아가 오늘 문제를 다시 받으세요.");
    return withLock_(() => {
      const key = d + "|" + scope + "|" + me.who;
      const rec = load_().find(r => r.key === key);
      const prev = rec ? rec.attempts : 0, att = parseInt(req.attempt, 10) || 0;
      if (rec && (!s.allowRetry || att < prev)) return { mode: "result", result: result_(rec), note: "이미 제출한 시험입니다." };
      const qs = pickSet(scope, d + "|" + scope + "|" + me.who + "-" + me.name + "|" + att);
      const answers = qs.map((_, p) => String((req.answers || [])[p] || "").trim().slice(0, 60));
      const next = { row: rec ? rec.row : null, date: d, scope, cls: me.cls, num: me.num, name: me.name, key, qs, answers, overrides: {},
        submittedAt: Utilities.formatDate(new Date(), TZ, "HH:mm:ss"), attempts: prev + 1 };
      writeRow_(next);
      return { mode: "result", result: result_(next) };
    });
  },
  // ----- teacher -----
  tData(req) {
    checkPw_(req.pw);
    const all = load_(), dates = [...new Set([todayKST_(), ...all.map(r => r.date)])].sort().reverse();
    const want = req.date || todayKST_();
    const list = all.filter(r => want === "all" || r.date === want).map(r => {
      const g = gradeSub(r);
      return { key: r.key, date: r.date, scope: r.scope, cls: r.cls, num: r.num, name: r.name, score: g.score, total: g.total, submittedAt: r.submittedAt, attempts: r.attempts,
        items: g.items.map(x => ({ p: x.p, qi: x.qi, ans: x.ans, ok: x.ok, ov: !!(r.overrides || {})[x.qi] })) };
    });
    return { today: todayKST_(), dates, date: want, list, settings: settings_(), questions: Q.map(q => ({ a: q.a, b: q.b, c: q.c })), sheetUrl: SpreadsheetApp.getActiveSpreadsheet().getUrl() };
  },
  tOverride(req) {
    checkPw_(req.pw);
    withLock_(() => { const rec = load_().find(r => r.key === req.key); if (!rec) return; rec.overrides = rec.overrides || {};
      if (req.on) rec.overrides[req.qi] = true; else delete rec.overrides[req.qi]; writeRow_(rec); });
    return ROUTES.tData(req);
  },
  tResetOne(req) {
    checkPw_(req.pw);
    withLock_(() => { const rec = load_().find(r => r.key === req.key); if (rec) sheet_().deleteRow(rec.row); });
    return ROUTES.tData(req);
  },
  tResetDay(req) {
    checkPw_(req.pw);
    withLock_(() => { const sh = sheet_(); load_().filter(r => r.date === req.day).map(r => r.row).sort((a, b) => b - a).forEach(row => sh.deleteRow(row)); });
    return ROUTES.tData(req);
  },
  tResetAll(req) {
    checkPw_(req.pw);
    withLock_(() => { const sh = sheet_(); if (sh.getLastRow() > 1) sh.deleteRows(2, sh.getLastRow() - 1); });
    return ROUTES.tData(req);
  },
  tSettings(req) {
    checkPw_(req.pw);
    const p = PropertiesService.getScriptProperties(), o = req.settings || {};
    if ("showAnswers" in o) p.setProperty("showAnswers", String(!!o.showAnswers));
    if ("allowRetry" in o) p.setProperty("allowRetry", String(!!o.allowRetry));
    if ("fixedScope" in o) p.setProperty("fixedScope", SCOPES[o.fixedScope] ? o.fixedScope : "");
    return ROUTES.tData(req);
  },
};
